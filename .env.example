SHOPPING_DATA_DIR=data
SHOPPING_DB=data/shopping.sqlite3
SHOPPING_TOP_K=8
# Required OpenAI-compatible endpoint. Requests fail clearly if unavailable.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_THINKING_ENABLED=0
# 旧版 LLM_* 变量继续兼容，但新配置优先使用上面的 DEEPSEEK_*。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=45
LLM_MAX_OUTPUT_TOKENS=700
# 按当前供应商账单填写每百万 token 单价；运行指标会据此计算成本。
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
# 本地多路召回与独立精排默认开启。
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
PROMPT_VERSION=v1
# BGE-M3 稠密向量，使用 Colab 离线构建的 FAISS IVF-PQ 索引。
EMBEDDING_MODE=faiss
EMBEDDING_MODEL=BAAI/bge-m3
# 275 万商品时 attributes 字段约占 2.3 GB（0.85 KB/条）。设为 0 可显著省内存，
# 代价是 compare 功能里 attributes 显示为"数据集未提供"。商品检索不受影响。
LOAD_ATTRIBUTES=1
# int8 动态量化。实测（torch 2.14 / CPU）不值得开启：量化 CrossEncoder 会破坏 HF 的
# forward 签名映射导致推理报错，且 quantize_dynamic 会复制一份 fp32，稳态内存反而更高。
# 保留为实验开关，默认 none。
MODEL_QUANTIZE=none

# ---- 多层上下文与长期记忆 ----
# 上下文预算按估算 token 计（中文 1 字≈1 token，英文 4 字符≈1 token）。
CONTEXT_TOKEN_BUDGET=2200
CONTEXT_RECENT_LIMIT=8
# Agent 每轮结束后自动抽取稳定偏好并写入长期记忆（跨会话）。
MEMORY_MAX_INJECTED=12
MEMORY_CAPTURE_MAX_TOKENS=320

# ---- Token 成本控制 ----
# 工具结果回灌给模型前先裁剪，只保留判断所需字段（剔除 attributes）。
TOOL_RESULT_MAX_CHARS=6000
